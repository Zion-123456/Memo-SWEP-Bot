# =============================================================================
# Application
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO

# =============================================================================
# Telegram
# =============================================================================
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Generate securely; letters, digits, underscores and hyphens only (32-256 chars).
TELEGRAM_WEBHOOK_SECRET=
# Render supplies RENDER_EXTERNAL_URL automatically; use PUBLIC_BASE_URL for a custom host.
PUBLIC_BASE_URL=
REGISTER_WEBHOOK=false

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://memo:memo@localhost:5432/memo

# =============================================================================
# Private storage (Supabase required for the Render Free pilot)
# =============================================================================
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=memo-private
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_SCHEMA=public
AI_ENABLED=false
GROQ_API_KEY=
# REDIS_URL is only used by the optional legacy state importer, never the web host.
